#!/usr/bin/env bash

set -euo pipefail

ENV="${ENV:-dev|prod}"
output_dir=.infisical
mkdir -p "$output_dir"

if [[ -z "${INFISICAL_PROJECT_ID:-}" && -f .infisical.json ]]; then
  INFISICAL_PROJECT_ID=$(jq -r '.workspaceId // empty' .infisical.json)
fi

if [[ -z "${INFISICAL_PROJECT_ID:-}" ]]; then
  printf 'INFISICAL_PROJECT_ID is required or must be present as workspaceId in .infisical.json\n' >&2
  exit 1
fi

project_args=(--projectId="$INFISICAL_PROJECT_ID")
domain_args=()
if [[ -n "${INFISICAL_DOMAIN:-}" ]]; then
  domain_args=(--domain="$INFISICAL_DOMAIN")
fi

umask 077
export INFISICAL_DISABLE_UPDATE_CHECK="${INFISICAL_DISABLE_UPDATE_CHECK:-true}"

IFS='|' read -r -a environments <<< "$ENV"

shopt -s nullglob
app_dirs=(*/)
apps=(base)
for app_dir in "${app_dirs[@]}"; do
  apps+=("${app_dir%/}")
done

for app in "${apps[@]}"; do

  for environment in "${environments[@]}"; do
    if [[ -z "$environment" ]]; then
      printf 'ENV contains an empty value\n' >&2
      exit 1
    fi

    if [[ ! "$environment" =~ ^[a-zA-Z0-9_-]+$ ]]; then
      printf 'Invalid environment name: %s\n' "$environment" >&2
      exit 1
    fi

    if [[ "$app" == "base" ]]; then
      output_file="$output_dir/$environment.env"
      path_args=()
    else
      output_file="$output_dir/$app-$environment.env"
      path_args=(--path="/$app")
    fi

    temporary_file=$(mktemp "$output_file.tmp.XXXXXX")
    error_file=$(mktemp "$output_file.error.XXXXXX")
    chmod 600 "$temporary_file"
    chmod 600 "$error_file"
    trap 'rm -f "$temporary_file" "$error_file"' EXIT

    if ! infisical export \
      "${domain_args[@]}" \
      "${project_args[@]}" \
      --format=dotenv \
      --env="$environment" \
      "${path_args[@]}" \
      > "$temporary_file" 2> "$error_file"; then
      error_output=$(<"$error_file")
      if [[ "$error_output" == *"404 Not Found"* || "$error_output" == *"not found"* || "$error_output" == *"does not exist"* ]]; then
        rm -f "$temporary_file" "$error_file"
        trap - EXIT
        printf 'Skipped %s (not found)\n' "${output_file#./}"
        continue
      fi

      printf '%s\n' "$error_output" >&2
      exit 1
    fi

    rm -f "$error_file"

    if [[ ! -s "$temporary_file" ]]; then
      rm -f "$temporary_file"
      trap - EXIT
      printf 'Skipped %s (empty)\n' "${output_file#./}"
      continue
    fi

    mv -f "$temporary_file" "$output_file"
    trap - EXIT
    chmod 600 "$output_file"
    printf 'Exported %s\n' "${output_file#./}"
  done
done
