Port 2222
HostKey /var/lib/devbox/ssh/ssh_host_ed25519_key
# ConfigMap projection directories are 0777, despite the read-only mount.
AuthorizedKeysFile none
AuthorizedKeysCommand /usr/bin/cat /etc/devbox/authorized_keys/%u
AuthorizedKeysCommandUser nobody
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
AllowUsers norris
UsePAM no
Subsystem sftp internal-sftp
